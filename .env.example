# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set to 0 when TLS is terminated elsewhere and you test over plain http.
DJANGO_SECURE_SSL_REDIRECT=0

# --- Database (docker-compose sets the host) ---
POSTGRES_DB=gheymat
POSTGRES_USER=gheymat
POSTGRES_PASSWORD=change-me

# --- Public URLs used in emails ---
SITE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# --- Prices ---
# 1 = random demo data (no API keys needed). 0 = real sources.
PRICE_DEMO_MODE=1
# Iranian market source for free-market dollar, gold and coins: brsapi | navasan
IRAN_PROVIDER=brsapi
BRSAPI_KEY=
NAVASAN_API_KEY=
# Optional CoinGecko demo key (higher rate limit)
COINGECKO_API_KEY=
PRICE_UPDATE_SECONDS=60

# --- Email (SMTP) ---
# Console backend prints emails to the logs; switch to SMTP for real sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=قیمت <no-reply@example.com>
